<odoo>
  <record id="view_manual_generator_form" model="ir.ui.view">
    <field name="name">manual.generator.form</field>
    <field name="model">manual.generator</field>
    <field name="arch" type="xml">
      <form string="Generate AI User Manual">
        <sheet>
          <group>
            <field name="name"/>
            <field name="module_ids" widget="many2many_tags"/>
            <field name="prompt_template" colspan="4"/>
          </group>
          <group>
            <field name="content" widget="html" readonly="1"/>
                        <field name="manual_file" filename="manual_filename" widget="binary"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_manual_generator" model="ir.actions.act_window">
    <field name="name">Generate AI Manual</field>
    <field name="res_model">manual.generator</field>
    <field name="view_mode">form</field>
    <field name="target">current</field>
  </record>

  <menuitem id="menu_manual_generator_root" name="AI Manual Generator" sequence="10"/>
  <menuitem id="menu_manual_generator" name="Generate Manual" parent="menu_manual_generator_root" action="action_manual_generator"/>



</odoo>
