<odoo>
  <data noupdate="1">
    <record id="ir_cron_desklog_cleanup" model="ir.cron">
      <field name="name">Desklog: Purge old screenshots</field>
      <field name="model_id" ref="model_desklog_screenshot"/>
      <field name="state">code</field>
      <field name="code">model.env["desklog.screenshot"]._cron_cleanup()</field>
      <field name="interval_number">1</field>
      <field name="interval_type">days</field>
      <field name="numbercall">-1</field>
      <field name="active">True</field>
    </record>
  </data>
</odoo>
